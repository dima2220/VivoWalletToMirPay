<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">#FF111318</item>
        <item name="android:navigationBarColor">#FF111318</item>
        <item name="android:windowBackground">#FF111318</item>
    </style>

    <!-- Тема прозрачной SwipeEntryActivity.
         Минималистичная, как в MiCTS Theme.App.Transparent:
           - windowIsTranslucent=true
           - windowBackground=transparent
           - statusBar / navigationBar = transparent
         БЕЗ backgroundDimEnabled, БЕЗ windowAnimationStyle=InputMethod, БЕЗ windowTranslucentStatus —
         эти атрибуты делают активность «диалогоподобной», и на некоторых ROM системный
         VoiceInteractionService отказывается запускаться из диалогоподобных окон. -->
    <style name="TransparentSwipeTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
