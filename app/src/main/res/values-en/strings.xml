    <string name="btn_resolve">Trigger NFC_BUS_SWINGSPLASH (“Always”)</string>
    <string name="btn_resolve_hint">Sends the same system Intent Vivo sends on a double press. Pick “Always” in the chooser to make this app the permanent handler.</string>
    <string name="btn_appinfo">Current handler app info</string>
    <string name="btn_appinfo_hint">Opens system settings for the currently assigned handler app. Reset the default there to bring the “Always” dialog back.</string>

